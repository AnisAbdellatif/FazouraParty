# Caddy runs on the host, not in the stack — it was already terminating TLS for this
# machine, and two of them cannot both hold :443.
#
# This file is a copy of what that Caddy needs, not something anything installs: the
# host's configuration belongs to the host, and nothing in this repository writes to
# /etc/caddy. Put it in the host's Caddyfile (or a site file it imports), substitute
# the domain, and `sudo systemctl reload caddy`.
#
# The app publishes 127.0.0.1:4000 (compose.yaml). Loopback is the whole security
# boundary here: TRUST_PROXY=true tells the app to believe the last X-Forwarded-For
# entry, which is only honest because the proxy below is the only thing that can
# reach it.

party.example.com {
	encode zstd gzip

	# The largest body the app ever takes is 32 MB (a private quiz sent inline, or a
	# package for review). Refused here, before a byte reaches the app.
	request_body {
		max_size 33MB
	}

	# The service worker owns caching (AGENTS.md §5): the app answers with
	# `max-age=0, must-revalidate` and ETags, and nothing here may extend that.
	reverse_proxy 127.0.0.1:4000 {
		# Phoenix reads these to know it is behind HTTPS (`force_ssl` in prod.exs).
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
	}
}
