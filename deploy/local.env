# Values for the `${VAR:?}` guards in compose.yaml, used only with
# compose.local.yaml. Compose interpolates those before the override is merged, so
# they have to be set even though compose.local.yaml replaces what they feed.
#
# Not secrets: this stack is loopback-only and its database holds nothing real. The
# production equivalent is deploy/.env, which exists only on the VPS and is never
# committed.
APP_IMAGE=fazoura
APP_TAG=local
PHX_HOST=localhost
POSTGRES_PASSWORD=local-development-only
