# Copy to <deploy path>/.env on the VPS and fill in, next to compose.yaml. It lives
# only there: CI never ships, reads or overwrites it. Never commit the filled-in file.

# The domain Caddy gets a certificate for, and the host Phoenix builds URLs with
# (photo URLs are absolute, so getting this wrong breaks photos).
PHX_HOST=party.example.com

# `mix phx.gen.secret` — 64+ random bytes, base64. Changing it invalidates every
# host and player token, which ends every live game.
SECRET_KEY_BASE=

# Postgres. The password is only used between the two containers, so make it long.
POSTGRES_DB=fazoura
POSTGRES_USER=fazoura
POSTGRES_PASSWORD=

# /admin 404s unless BOTH are set — that is how it stays unadvertised.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The app is served from the same origin as the API, so no cross-origin allowance
# is needed. Set this only if you host the web app somewhere else.
CORS_ORIGINS=

# Rate limiting counts per client IP, which behind Caddy means the last entry of
# X-Forwarded-For. Leave this alone for the stack in compose.yaml. Set it to false only
# if Phoenix is exposed directly, where that header is client-written and trusting it
# would let anyone reset their own limit.
# TRUST_PROXY=true
