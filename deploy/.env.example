# Copy to <deploy dir>/.env on the VPS (/srv/fazoura/.env) and fill in. It lives only
# there: nothing that deploys ships, reads or overwrites it. Both containers read it
# (--env-file in deploy/deploy.yml) — the app all of it, Postgres its POSTGRES_* lines.
# Never commit the filled-in file.
#
# Docker reads this file literally: no quotes around values, no `$VAR` expansion, no
# `export`. A value in quotes keeps its quotes.

# The domain Caddy gets a certificate for, and the host Phoenix builds URLs with
# (photo URLs are absolute, so getting this wrong breaks photos). The same domain is
# FAZOURA_PUBLIC_HOST in .kamal/kit.local.env, which kamal-proxy routes on.
PHX_HOST=party.example.com

# `mix phx.gen.secret` — 64+ random bytes, base64. Changing it invalidates every
# host and player token, which ends every live game.
SECRET_KEY_BASE=

# Postgres. The password is only used between the two containers, so make it long —
# and `openssl rand -hex 32`, because it goes into DATABASE_URL below, where `/`, `@`,
# `?`, `#` and `%` would break the URL.
POSTGRES_DB=fazoura
POSTGRES_USER=fazoura
POSTGRES_PASSWORD=

# The same user, password and database; the host is the Postgres container's name on
# Kamal's network. Docker does not expand variables here, so write the password out.
DATABASE_URL=postgres://fazoura:<POSTGRES_PASSWORD>@fazoura-db:5432/fazoura

# /admin 404s unless BOTH are set — that is how it stays unadvertised.
# Wrong passwords are limited to ten a minute per address, which is a brake, not a
# lock: use a long random password (`openssl rand -base64 32`), not a word.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# The app is served from the same origin as the API, so no cross-origin allowance
# is needed. Set this only if you host the web app somewhere else.
CORS_ORIGINS=

# TRUST_PROXY (how many proxies' X-Forwarded-For entries to believe) is set in
# deploy/deploy.yml, next to the proxies it counts, and wins over anything here.
