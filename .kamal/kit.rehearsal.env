# deploy-kit for the deploy rehearsal (deploy/rehearsal/rehearse.sh): `kit … -d
# rehearsal`. Its "server" is a container on this machine, its images come from a
# local registry and are built from the working tree: no git, CI or attestation gates,
# which have nothing to check here; the migrations and the rest as in production.
KIT_DEPLOY_SKIP_PUSH=true
KIT_HOOK_PRE_DEPLOY="freeze role-guard migrate notify"
