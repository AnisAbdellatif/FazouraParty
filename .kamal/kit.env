# deploy-kit settings for Fazoura (committed). Every setting and its default:
# .kamal/kit/lib/defaults.sh; explained in the kit's docs/configuration.md.
# The server itself (address, user, domain, smoke URL, alert channels) goes in
# .kamal/kit.local.env (git-ignored; see kit.local.env.example).
#
# A deploy is `.kamal/kit/bin/kit deploy`, from a checkout of main
# (deploy/README.md, "Every deploy").

KIT_KAMAL_CONFIG_FILE=deploy/deploy.yml

# The image is built, labelled and attested by CI on main (.github/workflows/ci.yml):
# its web app comes from a Flutter build Kamal cannot make. A deploy pulls it and
# checks CI's signature on it, never builds.
KIT_DEPLOY_SKIP_PUSH=true
KIT_IMAGE=ghcr.io/anisabdellatif/fazouraparty
KIT_ATTESTATION_SIGNER_WORKFLOW=AnisAbdellatif/FazouraParty/.github/workflows/ci.yml

# Gates, then the migrations and the quiz seed from the new image (.kamal/steps/migrate),
# all before any container is replaced. Nothing is built here, so pre-build has
# nothing to check.
KIT_DEPLOY_BRANCH=main
KIT_HOOK_PRE_BUILD=
KIT_HOOK_PRE_DEPLOY="freeze role-guard require-branch require-clean require-pushed ci-green attestation migrate notify"

# Live games are told the server is closing them before the new container starts:
# kamal-proxy cuts the old one's WebSockets at the switch (.kamal/steps/drain-rooms).
KIT_HOOK_PRE_APP_BOOT="drain-rooms"

# Every check of the commit's CI run must have passed, the image included. Merging to
# main and deploying straight away waits for that run instead of refusing.
KIT_CI_WAIT=1800
