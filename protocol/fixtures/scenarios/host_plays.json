{
  "name": "host plays: no early reveal, host ends the question, corrects own answer; losing the host promotes the remaining player",
  "pack": {
    "title": "Fixture Pack",
    "questions": [
      {
        "id": "q1",
        "type": "text",
        "prompt": "Capital of Australia?",
        "accepted_answers": [
          "Canberra"
        ],
        "time_limit_ms": 30000
      }
    ]
  },
  "steps": [
    {
      "actor": "host",
      "join": {
        "protocol_version": 9,
        "host_token": "$host_token",
        "display_name": "Hana"
      },
      "expect": {
        "status": "ok",
        "response": {
          "role": "host",
          "player_token": null
        }
      }
    },
    {
      "actor": "sam",
      "join": {
        "protocol_version": 9,
        "display_name": "Sam"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "copycat",
      "join": {
        "protocol_version": 9,
        "display_name": "hana"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "name_taken"
        }
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "lobby",
        "players": [
          {
            "id": "$player_id:host",
            "name": "Hana",
            "is_host": true,
            "connected": true,
            "score": 0
          },
          {
            "name": "Sam",
            "is_host": false,
            "connected": true,
            "score": 0
          }
        ]
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "question",
        "accepted_answers": null,
        "submissions": null,
        "you": {
          "role": "host",
          "player_id": "$player_id:host",
          "submission": null
        }
      }
    },
    {
      "actor": "host",
      "push": "submit",
      "payload": {
        "answer": "Canbera"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "push": "submit",
      "payload": {
        "answer": "Canberra"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "already_submitted"
        }
      }
    },
    {
      "actor": "sam",
      "push": "submit",
      "payload": {
        "answer": "canberra"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "question",
        "accepted_answers": null,
        "submissions": null,
        "players": [
          {
            "name": "Hana",
            "has_submitted": true
          },
          {
            "name": "Sam",
            "has_submitted": true
          }
        ],
        "you": {
          "submission": {
            "answer": "Canbera",
            "correct": null,
            "delta": null
          }
        }
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "scoring",
        "accepted_answers": [
          "Canberra"
        ],
        "players": [
          {
            "name": "Sam",
            "score": 10
          },
          {
            "name": "Hana",
            "score": -10
          }
        ],
        "submissions": [
          {
            "player_id": "$player_id:sam",
            "answer": "canberra",
            "auto_correct": true,
            "override": null,
            "correct": true,
            "delta": 10
          },
          {
            "player_id": "$player_id:host",
            "answer": "Canbera",
            "auto_correct": false,
            "override": null,
            "correct": false,
            "delta": -10
          }
        ],
        "you": {
          "submission": {
            "correct": false,
            "delta": -10
          }
        }
      }
    },
    {
      "actor": "host",
      "push": "host_override",
      "payload": {
        "player_id": "$player_id:host",
        "correct": true
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "players": [
          {
            "name": "Hana",
            "score": 10
          },
          {
            "name": "Sam",
            "score": 10
          }
        ],
        "submissions": [
          {
            "player_id": "$player_id:host",
            "override": true,
            "correct": true,
            "delta": 10
          },
          {
            "player_id": "$player_id:sam",
            "correct": true
          }
        ]
      }
    },
    {
      "actor": "host",
      "disconnect": true
    },
    {
      "_comment": "Sam is the only one left, so the room promotes him rather than sitting hostless (PROTOCOL.md \u00a73.4). His snapshot carries the new host_token, sent to him alone.",
      "actor": "sam",
      "expect_state": {
        "players": [
          {
            "name": "Hana",
            "connected": false,
            "is_host": false
          },
          {
            "name": "Sam",
            "is_host": true
          }
        ],
        "you": {
          "role": "host",
          "player_id": "$player_id:sam"
        }
      }
    },
    {
      "_comment": "The old host's token belonged to the previous generation and no longer verifies (\u00a73.3), so a former host cannot take the room back.",
      "actor": "ghost",
      "join": {
        "protocol_version": 9,
        "host_token": "$host_token"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "invalid_token"
        }
      }
    },
    {
      "_comment": "Sam now holds the role and can drive the game.",
      "actor": "sam",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "leaderboard"
      }
    }
  ]
}
