{
  "name": "player reconnects with token; host pauses and resumes the timer",
  "pack": {
    "title": "Fixture Pack",
    "questions": [
      {
        "id": "q1",
        "type": "text",
        "prompt": "2 + 2?",
        "accepted_answers": [
          "4",
          "four"
        ],
        "time_limit_ms": 20000
      },
      {
        "id": "q2",
        "type": "text",
        "prompt": "Colour of the sky?",
        "accepted_answers": [
          "blue"
        ],
        "time_limit_ms": 20000
      }
    ]
  },
  "steps": [
    {
      "actor": "host",
      "join": {
        "protocol_version": 9,
        "host_token": "$host_token"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "join": {
        "protocol_version": 9,
        "display_name": "Sam"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "_comment": "Kim never answers a single question. Without somebody still owing an answer, Sam submitting would end the question on the spot (§6) and there would be no running timer left to pause.",
      "actor": "kim",
      "join": {
        "protocol_version": 9,
        "display_name": "Kim"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "old",
      "join": {
        "protocol_version": 3,
        "display_name": "Old"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "unsupported_protocol_version"
        }
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "push": "submit",
      "payload": {
        "answer": "Four"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "disconnect": true
    },
    {
      "actor": "host",
      "expect_state": {
        "players": [
          {
            "name": "Kim",
            "connected": true,
            "has_submitted": false
          },
          {
            "name": "Sam",
            "connected": false,
            "has_submitted": true
          }
        ]
      }
    },
    {
      "actor": "host",
      "push": "host_pause",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "question",
        "deadline": null,
        "paused_remaining_ms": 20000
      }
    },
    {
      "actor": "host",
      "push": "host_pause",
      "payload": {},
      "expect": {
        "status": "error",
        "response": {
          "code": "paused"
        }
      }
    },
    {
      "advance_clock_ms": 60000
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "question"
      }
    },
    {
      "actor": "sam",
      "join": {
        "protocol_version": 9,
        "player_token": "$player_token:sam"
      },
      "expect": {
        "status": "ok",
        "response": {
          "role": "player",
          "player_id": "$player_id:sam"
        }
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "question",
        "paused_remaining_ms": 20000,
        "you": {
          "player_id": "$player_id:sam",
          "submission": {
            "answer": "Four"
          }
        }
      }
    },
    {
      "actor": "host",
      "push": "host_resume",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "advance_clock_ms": 20000
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "scoring",
        "players": [
          {
            "name": "Sam",
            "score": 10,
            "connected": true
          },
          {
            "name": "Kim",
            "score": -10,
            "connected": true
          }
        ]
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "question",
        "question_index": 1,
        "you": {
          "submission": null
        }
      }
    },
    {
      "actor": "late",
      "join": {
        "protocol_version": 9,
        "display_name": "Late"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "late",
      "expect_state": {
        "phase": "question",
        "players": [
          {
            "name": "Sam",
            "score": 10
          },
          {
            "name": "Late",
            "score": 0
          },
          {
            "name": "Kim",
            "score": -10
          }
        ]
      }
    },
    {
      "advance_clock_ms": 30000
    },
    {
      "actor": "late",
      "expect_state": {
        "phase": "scoring",
        "players": [
          {
            "name": "Late",
            "score": 0
          },
          {
            "name": "Sam",
            "score": 0
          },
          {
            "name": "Kim",
            "score": -20
          }
        ],
        "submissions": [
          {
            "player_id": "$player_id:sam",
            "answer": null,
            "auto_correct": false,
            "override": null,
            "correct": false,
            "delta": -10
          },
          {
            "player_id": "$player_id:kim",
            "answer": null,
            "auto_correct": false,
            "override": null,
            "correct": false,
            "delta": -10
          }
        ],
        "you": {
          "submission": null
        }
      }
    }
  ]
}
