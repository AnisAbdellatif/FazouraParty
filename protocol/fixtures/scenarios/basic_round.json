{
  "name": "non-playing host, two players, one question, host override, finish",
  "pack": {
    "title": "Fixture Pack",
    "questions": [
      {
        "id": "q1",
        "type": "text",
        "prompt": "Capital of Australia?",
        "accepted_answers": [
          "Canberra"
        ],
        "time_limit_ms": 30000
      }
    ]
  },
  "steps": [
    {
      "actor": "host",
      "join": {
        "protocol_version": 9,
        "host_token": "$host_token"
      },
      "expect": {
        "status": "ok",
        "response": {
          "role": "host",
          "player_id": null
        }
      }
    },
    {
      "actor": "sam",
      "join": {
        "protocol_version": 9,
        "display_name": "Sam"
      },
      "expect": {
        "status": "ok",
        "response": {
          "role": "player"
        }
      }
    },
    {
      "actor": "alex",
      "join": {
        "protocol_version": 9,
        "display_name": "alex"
      },
      "expect": {
        "status": "ok",
        "response": {
          "role": "player"
        }
      }
    },
    {
      "actor": "dup",
      "join": {
        "protocol_version": 9,
        "display_name": "SAM"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "name_taken"
        }
      }
    },
    {
      "actor": "sam",
      "push": "submit",
      "payload": {
        "answer": "x"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "invalid_phase"
        }
      }
    },
    {
      "actor": "sam",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "error",
        "response": {
          "code": "not_host"
        }
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "players": [
          {
            "name": "alex",
            "connected": true,
            "has_submitted": false,
            "is_host": false
          },
          {
            "name": "Sam",
            "connected": true,
            "has_submitted": false,
            "is_host": false
          }
        ]
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "question",
        "question_index": 0,
        "question_count": 1,
        "question": {
          "id": "q1",
          "prompt": "Capital of Australia?"
        },
        "accepted_answers": null,
        "submissions": null
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "question",
        "accepted_answers": null,
        "submissions": null,
        "you": {
          "role": "host",
          "player_id": null,
          "submission": null
        }
      }
    },
    {
      "actor": "host",
      "push": "submit",
      "payload": {
        "answer": "Canberra"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "not_player"
        }
      }
    },
    {
      "actor": "sam",
      "push": "submit",
      "payload": {
        "answer": "   "
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "invalid_answer"
        }
      }
    },
    {
      "actor": "sam",
      "push": "submit",
      "payload": {
        "answer": "  canberra "
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "push": "submit",
      "payload": {
        "answer": "Sydney"
      },
      "expect": {
        "status": "error",
        "response": {
          "code": "already_submitted"
        }
      }
    },
    {
      "_comment": "Only Sam has answered, so the question is still running and nobody sees an answer yet (§7).",
      "actor": "sam",
      "expect_state": {
        "phase": "question",
        "accepted_answers": null,
        "submissions": null,
        "you": {
          "submission": {
            "answer": "canberra",
            "correct": null,
            "delta": null
          }
        }
      }
    },
    {
      "actor": "alex",
      "push": "submit",
      "payload": {
        "answer": "Canbera"
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "_comment": "alex has answered too, so there is nobody left to wait for and the question ends on the spot (PROTOCOL.md §6).",
      "actor": "alex",
      "expect_state": {
        "phase": "scoring",
        "accepted_answers": [
          "Canberra"
        ],
        "you": {
          "submission": {
            "answer": "Canbera",
            "correct": false,
            "delta": -10
          }
        }
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "scoring",
        "accepted_answers": [
          "Canberra"
        ],
        "players": [
          {
            "name": "Sam",
            "score": 10,
            "has_submitted": true
          },
          {
            "name": "alex",
            "score": -10,
            "has_submitted": true
          }
        ]
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "scoring",
        "accepted_answers": [
          "Canberra"
        ]
      }
    },
    {
      "actor": "host",
      "push": "host_override",
      "payload": {
        "player_id": "$player_id:alex",
        "correct": true
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "alex",
      "expect_state": {
        "players": [
          {
            "name": "alex",
            "score": 10
          },
          {
            "name": "Sam",
            "score": 10
          }
        ],
        "you": {
          "submission": {
            "correct": true,
            "delta": 10
          }
        }
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "host",
      "expect_state": {
        "phase": "leaderboard"
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "ok"
      }
    },
    {
      "actor": "sam",
      "expect_state": {
        "phase": "finished",
        "question": null,
        "accepted_answers": null,
        "submissions": null
      }
    },
    {
      "actor": "host",
      "push": "host_next",
      "payload": {},
      "expect": {
        "status": "error",
        "response": {
          "code": "invalid_phase"
        }
      }
    }
  ]
}
